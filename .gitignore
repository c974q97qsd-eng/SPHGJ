# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pyinstaller/

# 前端构建产物 / 依赖
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.d.ts
frontend/vite.config.js

# 运行时数据(整目录排除,防止新类型子文件漏网上传)
profiles/
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# agent 本地工作数据(内存采样日志等,非源码)
.workbuddy/

# 打包产物
build/
/dist/
*.spec

# 日志
*.log

# 本地配置 / 账号数据(含本地账号与登录态,禁止提交)
config.json
config.*.json
!config.example.json
.env
.env.*

# 前端构建产物(不应纳入版本库)
frontend/dist/

# 杂项垃圾 / 临时文件
nul
*.lnk
*.timestamp-*.mjs
build - 副本.bat
frontend/NPM RUN BUIID.BAT

# 更新包 / 离线环境包(体积大且可再生,不入库)
UP/
配置环境安装/

# 根目录临时脚本与中转文件
/_*.py
/_*.txt
/_*.log

# 本地核对/审计报告(只留本地,不上传仓库)
/版本核对报告-*.md
